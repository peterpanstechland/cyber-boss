# Feishu / Lark Bot credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# Target user open_id (for proactive trigger)
FEISHU_USER_OPEN_ID=ou_xxxxxxxxxxxx

# Bitable task pool
BITABLE_BASE_ID=your_bitable_base_id
BITABLE_TABLE_ID=your_bitable_table_id

# Dashboard
PORT=18062
CB_DATA_DIR=/app/data
CB_DAILY_LOG_DIR=/path/to/agent/memory
